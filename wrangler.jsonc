// Cloudflare Workers config. Static files only: there is no Worker script.
{
  "name": "davidpereira-cc",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    // Serve /lagosta (the QR code URL) directly with 200; /lagosta/ redirects to it.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
